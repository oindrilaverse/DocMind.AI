# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings
# Replace with your actual PostgreSQL connection string. Must have pgvector extension installed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docmind_ai

# Security Settings
# Generate strong secrets for production (e.g. using `openssl rand -hex 64`)
JWT_ACCESS_SECRET=your_jwt_access_secret_should_be_long_and_secure
JWT_REFRESH_SECRET=your_jwt_refresh_secret_should_be_long_and_secure

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# Storage Settings
UPLOAD_DIR_ORIGINALS=uploads/originals
UPLOAD_DIR_EXTRACTED=uploads/extracted

# Ollama LLM and Embeddings Settings (Local RAG Configuration)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2
